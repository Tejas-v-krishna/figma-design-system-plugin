{
  "name": "design-system-kit",
  "version": "1.0.0",
  "description": "Figma plugin that generates a complete design system: color, type, spacing, radius and elevation tokens, Figma styles and variables, 50 components, and token export to CSS, Tailwind and DTCG.",
  "license": "MIT",
  "author": "Tejas V Krishna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tejas-v-krishna/figma-design-system-plugin.git"
  },
  "homepage": "https://github.com/Tejas-v-krishna/figma-design-system-plugin#readme",
  "bugs": {
    "url": "https://github.com/Tejas-v-krishna/figma-design-system-plugin/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.dev.config.ts",
    "watch": "vite build --watch --mode development --config vite.ui.config.ts & vite build --watch --mode development --config vite.config.ts",
    "build": "vite build --config vite.ui.config.ts && vite build --config vite.config.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "lint:fix": "eslint . --fix",
    "check:config": "tsx scripts/check-config-schema.ts",
    "check:dtcg": "tsx scripts/check-dtcg-parity.ts"
  },
  "dependencies": {
    "culori": "^4.0.2",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@figma/plugin-typings": "^1.85.0",
    "@types/culori": "^4.0.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.0.8",
    "vite-plugin-static-copy": "^1.0.0"
  }
}
